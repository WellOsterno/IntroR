"Zeta", "Eta", "Teta", "Iota", "Kappa"),
ExpectativaVida = c(60, 64, 67, 70, 73, 76, 79, 81, 83, 85),
TFT = c(5.8, 5.0, 4.3, 3.6, 3.0, 2.5, 2.0, 1.8, 1.6, 1.4)
)
# Gráfico
