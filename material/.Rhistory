# Importar a base de dados
library(readxl)
#
pop_single <- readxl::read_excel("E:/Minicursos/IntroR/bases/base_pop_s_age.xlsx")
#
# # Visualizar a base
head(pop_single)
# Ferramenta básica do R
br_vetor <- pop_single$`Brasil, 1970`
co_vetor <- pop_single$`Colômbia, 1973`
mo_vetor <- pop_single$`Moçambique, 1997`
Age <- pop_single$Idade
# Com dplyr
# Perceba   que não estamos salvando o resultado no objeto, então o que vale é o que fizemos anteriormente.
library(dplyr)
pop_single %>%
pull(`Brasil, 1970`)
# Cálculo do Índice de Whipple por país
library(DemoTools)
br_whippleI <-  check_heaping_whipple(
Value = br_vetor,
Age = Age,
ageMin = 23,
ageMax = 62,
digit = c(0, 5)
)
co_whippleI <- check_heaping_whipple(
Value = co_vetor,
Age = Age,
ageMin = 23,
ageMax = 62,
digit = c(0, 5)
)
mo_whippleI <- check_heaping_whipple(
Value = mo_vetor,
Age = Age,
ageMin = 23,
ageMax = 62,
digit = c(0, 5)
)
print(br_whippleI)
print(co_whippleI)
print(mo_whippleI)
#| echo: false
plot(Age, mo_vetor,
xlab="Idade",
ylab="População",
type='l',
main="População por idade simples em Moçambique (1997)")
# Importar a base da população de moçambique por quinquenio
pop_abr <- readxl::read_excel("E:/Minicursos/IntroR/bases/base_pop_abr_age.xlsx")
# Visualizar a base
head(pop_abr)
# argumentos da função:
# Value:
mo_abr_vetor <- pop_abr$pop
library(stringr)
# Age
AgeAbr <- pop_abr %>%
mutate(
Age =
as.numeric(str_extract(
string = pop_abr$Idade,
pattern = "\\d+"))
) %>%
pull(Age)
print(mo_abr_vetor)
print(AgeAbr)
# Aplicar a função para interpolar
sprague <- graduate(
Value = mo_abr_vetor,
Age = AgeAbr,
method = "sprague")
single_age  <- names2age(sprague) # identifica a idade simples a partir do vetor criado pela função graduate.
print(sprague)
#| echo: false
mo_70 <- c(
mo_vetor[1:70],
sum(mo_vetor[71:length(mo_vetor)])
)
# Primeiro gráfico
plot(single_age, sprague,
type = "l",
ylab = "População",
xlab = "Idade",
main = "Interpolação com método de Sprague")
# Permite sobrepor outro gráfico
par(new = TRUE)
# Segundo gráfico
plot(single_age, mo_70,
type = "l",
axes = FALSE,     # não desenha os eixos novamente
xlab = "",
ylab = "",
col = "red")
# Importar as taxas específicas de mortalidade
nmx <- read_excel("E:/Minicursos/IntroR/bases/nmx_br_m_2022.xlsx")
head(nmx)
# Definir as faixas etárias
AgeLT <- nmx %>%
mutate(
age =
as.numeric(str_extract(
string = idade,
pattern = "\\d+"))
) %>%
pull(age)
# Definir as taxas específicas de mortalidade
tem <- nmx$nmx
# Tabela de vida por idade simples até 100 anos ou mais
br22 <- lt_abridged2single(
nMx = tem,
Age = AgeLT,
axmethod = "un",
OAG = TRUE, # True se o ultimo grupo é aberto
)
# View(br22) # para ver a tabela completa
